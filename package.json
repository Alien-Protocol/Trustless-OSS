{
  "name": "trustless-oss",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo dev --filter=@trustless-oss/frontend",
    "dev:frontend": "turbo dev --filter=@trustless-oss/frontend",
    "build": "turbo build",
    "build:frontend": "turbo build --filter=@trustless-oss/frontend",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "typecheck": "turbo typecheck",
    "fmt": "prettier --write \"**/*.{ts,tsx,js,json,md}\" --ignore-path .gitignore",
    "fmt:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\" --ignore-path .gitignore",
    "validate": "turbo typecheck lint && pnpm fmt:check",
    "clean": "turbo clean && rm -rf .turbo",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "turbo": "^2.0.0"
  },
  "lint-staged": {
    "apps/frontend/**/*.{ts,tsx}": [
      "prettier --write",
      "pnpm --filter @trustless-oss/frontend exec eslint --fix"
    ],
    "**/*.{json,md}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "protobufjs": ">=7.5.6",
      "postcss": ">=8.5.10",
      "uuid": ">=11.1.1",
      "ws": ">=8.21.0",
      "undici": ">=7.28.0"
    }
  }
}
